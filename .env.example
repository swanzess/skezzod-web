# Copy to .env.local for local dev. In CI, these are set as GitHub Actions
# secrets (see .github/workflows/deploy.yml) — same values as skezzod-app's
# EXPO_PUBLIC_* secrets, just under NEXT_PUBLIC_ names.

NEXT_PUBLIC_API_URL=https://skezzod-api-3evmje7tva-uc.a.run.app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skezzod-prod
NEXT_PUBLIC_STRIPE_PRICE_PERSONAL=
NEXT_PUBLIC_STRIPE_PRICE_FAMILY=
NEXT_PUBLIC_STRIPE_PRICE_FAMILYPLUS=

# The deployed origin — used to build Stripe Checkout success/cancel URLs
# and the billing-portal return URL.
NEXT_PUBLIC_SITE_URL=https://app.nerinest.com

# Web OAuth client ID for "Sign in with Google". Not a secret — it's meant
# to be public. Create it by enabling Google as a sign-in provider in the
# Firebase console (Authentication -> Sign-in method -> Google); Firebase
# provisions a Web client ID automatically. Then, in Google Cloud Console
# (APIs & Services -> Credentials -> that OAuth client), add this site's
# origin(s) — e.g. https://skezzod-prod.web.app and https://app.nerinest.com
# — to "Authorized JavaScript origins". Leave blank to hide the Google
# button (sign-in/sign-up still work fine with email+password alone).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
